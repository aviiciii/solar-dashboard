# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# JWT from the Polycab portal: log in at pv.polycabmonitoring.com, open DevTools ->
# Application -> Local Storage -> token (or the `authorization` header on any XHR request).
# It's long-lived (~360 days observed), so this only needs to be re-extracted if it
# ever gets invalidated - not on every run.
POLYCAB_TOKEN=

# Your inverter's serial number, e.g. "1234-123456789P" (found via the AllInverterList /
# InverterDetail responses, or in the portal's device list).
GOODS_ID=

# Your Polycab account id, e.g. "1234567" (found in the GetMemberData / getAllAllMember
# response, or in the JWT's `data.MemberAutoID` field if populated for your account).
MEMBER_AUTO_ID=

# Optional: earliest date to backfill history from on the very first run, format YYYY-MM-DD.
# If unset, the first run will only backfill from today onward (no pre-existing history).
# Set this to your plant's install/setup date to pull in everything the portal still has.
BACKFILL_START_DATE=

# --- Turso (cloud SQLite) ---
# The DB itself lives in Turso, not a local file, since the collector runs on ephemeral
# compute (GitHub Actions) with no disk that persists between runs.

# Connection URL for the database, e.g. libsql://solar-dashboard-<org>.aws-ap-south-1.turso.io
# (from `turso db show <name>` or the dashboard).
TURSO_DATABASE_URL=

# A per-database auth token (NOT the platform/management API token below), e.g. from
# `turso db tokens create <name>` or the dashboard. This is what collect.py actually
# connects with.
TURSO_AUTH_TOKEN=

# Platform API token (has an `org_id` claim, no database scope) - only used for one-time
# provisioning (creating the group/database/token above via api.turso.tech), never read
# by collect.py itself. Not needed as a GitHub Actions secret.
TURSO_API_TOKEN=

# Read-only per-database token, used only by backup/dump.py (the weekly backup, whose
# workflow + secrets live in the private aviiciii/solar-dashboard-backups repo) so it
# can't modify the live DB even by mistake. Create via the platform API:
#   POST https://api.turso.tech/v1/organizations/<org>/databases/<db>/auth/tokens?authorization=read-only
# (or `turso db tokens create <db> --read-only`).
TURSO_BACKUP_TOKEN=

# --- Daily alert (alerts/daily_alert.py) ---

# ntfy.sh topic to publish the daily summary to. Treat this like a secret - anyone who
# knows it can read your notifications (ntfy topics aren't private by obscurity alone).
# Generate something random, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
# Then install the ntfy Android/iOS app and subscribe to this same topic name.
NTFY_TOPIC=

# Coordinates for the daily weather summary (Open-Meteo, no API key needed). Set these
# to your plant's location.
WEATHER_LAT=
WEATHER_LON=

# Optional overrides (sensible defaults if unset):
# LOG_PATH=data/collector.log
# STALE_MINUTES=20
# MAX_BACKFILL_DAYS_PER_RUN=60

# Public URL of the deployed Streamlit Cloud dashboard. Only used by collect.yml (as a
# GitHub Actions secret) to ping the app so it doesn't sleep - kept out of the public repo.
DASHBOARD_URL=

# --- Admin tab (dashboard/app.py) ---

# Password gating the dashboard's "Admin" tab (manual re-backfill of a bad day). If
# left unset, the Admin tab is disabled entirely - not just "no password required".
ADMIN_PASSWORD=
